# Copy this file to .env. Keep .env private and out of GitHub.
# Generate a local agent token in PowerShell using the command in README.md.
ULTRON_AGENT_TOKEN=

# Agnes AI credentials (needed only for cloud image/video generation)
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_VIDEO_MODEL=agnes-video-2.5-flash

ULTRON_MEDIA_PORT=8766
